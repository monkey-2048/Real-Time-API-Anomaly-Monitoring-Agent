APP_NAME=EnvPulse
APP_ENV=dev
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=sqlite:////data/envpulse.db

REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=envpulse:observations

SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_TIMEZONE=UTC
RUN_SCHEDULER_IN_API=false

DEFAULT_LATITUDE=25.0330
DEFAULT_LONGITUDE=121.5654
DEFAULT_LOCATION_NAME=taipei

HTTP_TIMEOUT_SECONDS=8
HTTP_RETRY_ATTEMPTS=3

ANOMALY_CONTAMINATION=0.12
ANOMALY_MIN_SAMPLES=20

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12
